# MediaWatch - Environment Variables Configuration

# Discord Bot Configuration
# All four values are required.
# DISCORD_GUILD_ID is the ID of your Discord server: the slash commands are
# published there only, and without it MediaWatch does not start
# (right-click the server -> Copy Server ID).
DISCORD_TOKEN=
CHANNEL_ID=
DISCORD_AUTHORIZED_USERS=
DISCORD_GUILD_ID=

# Plex Configuration (required when media_server.type=plex)
PLEX_URL=
PLEX_TOKEN=

# Jellyfin Configuration (required when media_server.type=jellyfin)
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Tautulli Configuration (optional, Plex only)
TAUTULLI_URL=
TAUTULLI_API_KEY=

# SABnzbd Configuration
SABNZBD_URL=
SABNZBD_API_KEY=

# Uptime Kuma Configuration
UPTIME_URL=
UPTIME_USERNAME=
UPTIME_PASSWORD=
UPTIME_MONITOR_ID=
